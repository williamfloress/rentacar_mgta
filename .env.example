# Copia este archivo a backend/.env para desarrollo local SIN Docker.
# (docker compose ya define estas variables por sí mismo.) NUNCA subas .env a git.
#
# Neon: `neon init` escribe <raíz>/.env.local con DATABASE_URL (pooled) y
# DATABASE_URL_UNPOOLED (directa). La API carga ese archivo automáticamente y
# lo antepone a backend/.env; DATABASE_URL_UNPOOLED se usa para las migraciones
# si no defines MIGRATIONS_DATABASE_URL.

ENVIRONMENT=development

# Conexión de la API (en producción: rol restringido "rentacar_app")
DATABASE_URL=postgresql+psycopg://rentacar_app:rentacar_app_dev@localhost:5433/rentacar

# Conexión con permisos de dueño, solo para migraciones (opcional en local)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://rentacar:rentacar@localhost:5433/rentacar

# Genera una clave real con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

CORS_ORIGINS=http://localhost:5173
TIMEZONE=America/Caracas
LATE_FEE_MULTIPLIER=1.5
